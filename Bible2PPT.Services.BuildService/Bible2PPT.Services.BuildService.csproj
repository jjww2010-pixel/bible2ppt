<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Office" Version="12.0.0" GeneratePathProperty="true" ExcludeAssets="compile;runtime" />
    <PackageReference Include="Microsoft.Office.Interop.PowerPoint" Version="12.0.4518.1014" GeneratePathProperty="true" ExcludeAssets="compile;runtime" />
    <Reference Include="Office">
      <HintPath>$(PkgOffice)/lib/net40/Office.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.Office.Interop.PowerPoint">
      <HintPath>$(PkgMicrosoft_Office_Interop_PowerPoint)/lib/net20/Microsoft.Office.Interop.PowerPoint.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="6.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Linq.Async" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bible2PPT.Services.BibleService\Bible2PPT.Services.BibleService.csproj" />
    <ProjectReference Include="..\Bible2PPT.Services.TemplateService\Bible2PPT.Services.TemplateService.csproj" />
  </ItemGroup>

</Project>
